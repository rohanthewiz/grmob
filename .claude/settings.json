{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-doc-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
