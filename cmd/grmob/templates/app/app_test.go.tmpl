package app

import (
	"testing"

	"github.com/rohanthewiz/grmob/core"
	"github.com/rohanthewiz/grmob/grmobtest"
)

// The fastest loop there is: grmobtest drives the same render engine every
// target runs, with no browser, simulator or device. Taps and keystrokes go
// through the same dispatch path a finger does.

// TestMain turns on debug mode, which audits every render pass for hook-order
// drift and duplicate keys; NoConcerns fails the test on any finding.
func TestMain(m *testing.M) {
	core.SetDebugMode(true)
	m.Run()
}

func TestCounter(t *testing.T) {
	app := grmobtest.New(t, App)

	if !app.HasText("Count: 0") {
		t.Fatal("the counter does not start at 0")
	}
	app.Tap("+")
	app.Tap("+")
	app.Tap("-")
	if !app.HasText("Count: 1") {
		t.Fatal("+, +, - did not reach 1")
	}
	app.NoConcerns()
}
